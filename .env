# 数据库配置
DATABASE_URL=mysql+pymysql://root:2114@localhost:3306/decoration_ai
DB_ECHO=True

# JWT配置
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7天

# 微信小程序配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# AI服务配置（豆包/千问）
AI_TEXT_API_KEY=your_ai_api_key
AI_TEXT_API_URL=https://ark.cn-beijing.volces.com/api/v3
AI_IMAGE_API_KEY=your_image_api_key
AI_IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1

# 对象存储配置（腾讯云COS）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your_cos_bucket
COS_REGION=ap-beijing
COS_BASE_URL=https://your_bucket.cos.ap-beijing.myqcloud.com

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=True
